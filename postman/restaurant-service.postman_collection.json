    {
      "name": "Merchant",
      "description": "Merchant endpoints. The X-User-Id header simulates the API gateway-injected authenticated user id.",
      "item": [
        {
          "name": "Create restaurant",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString().slice(-9);",
                  "pm.collectionVariables.set('uniqueName', 'Test Restaurant ' + suffix);",
                  "pm.collectionVariables.set('uniqueEmail', 'owner' + suffix + '@example.com');",
                  "pm.collectionVariables.set('uniquePhone', '+20' + suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Restaurant is created pending approval', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data.status).to.eql('PENDING_APPROVAL');",
                  "    pm.expect(body.data.ownerId).to.eql(pm.collectionVariables.get('ownerId'));",
                  "});",
                  "",
                  "pm.test('Restaurant id is captured for subsequent requests', function () {",
                  "    pm.expect(body.data.id).to.be.a('string');",
                  "    pm.collectionVariables.set('restaurantId', body.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User-Id",
                "value": "{{ownerId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{uniqueName}}\",\n  \"description\": \"Created by the Postman collection\",\n  \"email\": \"{{uniqueEmail}}\",\n  \"phoneNumber\": \"{{uniquePhone}}\",\n  \"latitude\": 30.0444,\n  \"longitude\": 31.2357,\n  \"deliveryRadiusM\": 5000,\n  \"address\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"Cairo\",\n    \"state\": \"Cairo\",\n    \"country\": \"Egypt\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/merchants/restaurants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "merchants",
                "restaurants"
              ]
            },
            "description": "Creates a restaurant for {{ownerId}}. Generates a unique email and phone number on every run so repeated executions do not hit the duplicate constraints."
          },
          "response": []
        },
