{
  "info": {
    "_postman_id": "a3f3c1e2-7b4d-4c8a-9e11-2f6d5b8c0a91",
    "name": "Restaurant Service API",
    "description": "Collection for the restaurant-service API.\n\nBase URL defaults to http://localhost:8080/api (the service adds the /api prefix automatically).\n\nHow to run:\n1. Import this file in Postman (or run it with Newman).\n2. Run the requests in order:\n   - Public > List restaurants populates {{activeRestaurantId}} from the first ACTIVE restaurant in the database.\n   - Merchant > Create restaurant populates {{restaurantId}} and uses a unique email/phone per run.\n3. Merchant endpoints expect the X-User-Id header (normally injected by the API gateway after JWT validation). The collection uses a fixed UUID for {{ownerId}}.\n\nNote: newly created restaurants are PENDING_APPROVAL, so they are intentionally hidden from the public endpoints until activated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public",
      "description": "Customer-facing endpoints. Only ACTIVE restaurants are exposed.",
      "item": [
        {
          "name": "List restaurants",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Response envelope is successful', function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.data).to.be.an('object');",
                  "});",
                  "",
                  "pm.test('Returns a pagination envelope', function () {",
                  "    pm.expect(body.data.content).to.be.an('array');",
                  "    pm.expect(body.data.pagination).to.include.keys('pageNumber', 'pageSize', 'totalElements', 'totalPages', 'isLast');",
                  "});",
                  "",
                  "pm.test('Public payload hides internal fields', function () {",
                  "    body.data.content.forEach(function (restaurant) {",
                  "        pm.expect(restaurant).to.not.have.property('email');",
                  "        pm.expect(restaurant).to.not.have.property('ownerId');",
                  "        pm.expect(restaurant).to.not.have.property('status');",
                  "    });",
                  "});",
                  "",
                  "if (body.data.content.length > 0) {",
                  "    pm.collectionVariables.set('activeRestaurantId', body.data.content[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Returns a paginated list of ACTIVE restaurants, sorted by rating. Also stores the first returned id in {{activeRestaurantId}} so the details request can be run."
          },
          "response": []
        },
